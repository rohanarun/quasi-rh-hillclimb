/- Direct substituted return certificates at the rational target, derived from
   the boxes of tracker #143. Each leaf is checked with rational arithmetic. -/
import TargetEdgePolynomials
set_option autoImplicit false
set_option maxHeartbeats 0
set_option maxRecDepth 100000
namespace ContinuumLocalReturn.TargetEdges
open Cover
def domain : Box := ⟨0,3/4,0,1/2⟩
def witness : Edge → Cover
  | .oldLeft => .leaf .old
  | .oldRight => .cutD (3/8) (.leaf .old) (.leaf .old)
  | .newLeft => .cutD (3/8) (.leaf .old) (.leaf .old)
  | .seam => .cutD (3/8)
      (.cutP (1/4)
        (.cutD (3/16)
          (.leaf .old)
          (.cutP (1/8)
            (.leaf .old)
            (.cutD (9/32) (.leaf .old) (.cutP (3/16) (.leaf .old) (.leaf .nativeLow)))))
        (.cutD (9/32)
          (.cutD (15/64) (.leaf .old) (.leaf .nativeLow))
          (.cutP (7/16)
            (.leaf .nativeLow)
            (.cutD (21/64)
              (.leaf .native)
              (.cutP (15/32)
                (.leaf .native)
                (.cutD (45/128)
                  (.leaf .native)
                  (.cutP (31/64) (.leaf .native) (.cutD (189/512) (.leaf .native) (.leaf .marked)))))))))
      (.cutP (1/4)
        (.leaf .old)
        (.cutD (15/32)
          (.cutP (15/32)
            (.cutP (7/16) (.leaf .nativeLow) (.cutD (27/64) (.leaf .native) (.leaf .native)))
            (.cutD (27/64)
              (.leaf .marked)
              (.cutD (57/128)
                (.cutP (31/64) (.leaf .native) (.cutD (111/256) (.leaf .marked) (.leaf .marked)))
                (.leaf .marked))))
          (.cutD (9/16) (.cutP (3/8) (.leaf .old) (.leaf .native)) (.leaf .old))))
  | .top => .cutD (3/8)
      (.cutP (1/4)
        (.cutD (3/16)
          (.leaf .old)
          (.cutP (1/8)
            (.leaf .old)
            (.cutD (9/32) (.leaf .old) (.cutP (3/16) (.leaf .old) (.leaf .nativeLow)))))
        (.cutD (9/32)
          (.cutD (15/64) (.leaf .old) (.leaf .nativeLow))
          (.cutP (7/16)
            (.leaf .nativeLow)
            (.cutD (21/64)
              (.leaf .native)
              (.cutP (15/32)
                (.leaf .native)
                (.cutD (45/128)
                  (.leaf .native)
                  (.cutP (31/64) (.leaf .native) (.cutD (189/512) (.leaf .native) (.leaf .marked)))))))))
      (.cutP (1/4)
        (.leaf .old)
        (.cutD (15/32)
          (.cutP (15/32)
            (.cutP (7/16) (.leaf .nativeLow) (.cutD (27/64) (.leaf .native) (.leaf .native)))
            (.cutD (27/64)
              (.leaf .marked)
              (.cutD (57/128)
                (.cutP (31/64)
                  (.leaf .native)
                  (.cutD (111/256)
                    (.cutP (63/128)
                      (.leaf .marked)
                      (.cutD (219/512)
                        (.cutP (127/256)
                          (.leaf .marked)
                          (.cutD (435/1024)
                            (.leaf .marked)
                            (.cutP (255/512)
                              (.leaf .marked)
                              (.cutD (873/2048)
                                (.cutP (511/1024)
                                  (.leaf .marked)
                                  (.cutD (1743/4096)
                                    (.cutD (17/40) (.leaf .marked) (.cutP (9999/20000) (.leaf .marked) (.leaf .saved)))
                                    (.cutP (1023/2048)
                                      (.leaf .marked)
                                      (.cutD (3489/8192)
                                        (.cutP (2047/4096)
                                          (.leaf .marked)
                                          (.cutD (6975/16384)
                                            (.cutP (9999/20000) (.leaf .marked) (.leaf .saved))
                                            (.cutP (4095/8192)
                                              (.leaf .marked)
                                              (.cutD (13953/32768)
                                                (.cutP (9999/20000) (.leaf .marked) (.leaf .saved))
                                                (.cutP (9999/20000) (.leaf .marked) (.leaf .saved))))))
                                        (.cutP (9999/20000) (.leaf .marked) (.leaf .saved))))))
                                (.cutD (4267/10000) (.cutP (9999/20000) (.leaf .marked) (.leaf .saved)) (.leaf .marked))))))
                        (.leaf .marked)))
                    (.leaf .marked)))
                (.leaf .marked))))
          (.cutD (9/16) (.cutP (3/8) (.leaf .old) (.leaf .native)) (.leaf .old))))

theorem witness_checked (e : Edge) : (witness e).check e domain = true := by
  cases e <;> decide +kernel

theorem five_polynomial_edges (e : Edge) {d p : ℝ}
        (hd : d ∈ Set.Icc (0:ℝ) (3/4)) (hp : p ∈ Set.Icc (0:ℝ) (1/2)) :
    ∃ b, allowed e b d p ∧ 0 < QRH.ArviReturnTuning.Q2.ev (margin e b) d p := by
  apply (witness e).sound (witness_checked e)
  simpa [Box.contains,domain] using And.intro hd.1 (And.intro hd.2 hp)
end ContinuumLocalReturn.TargetEdges
#print axioms ContinuumLocalReturn.TargetEdges.five_polynomial_edges
